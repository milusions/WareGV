<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org" name="waregv">
    <xacro:arg name="sim_mode" default="false" />

    <ros2_control name="WareGVSystem" type="system">
        <hardware>
           
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
       
            <!-- <xacro:unless value="$(arg sim_mode)">
                <plugin>waregv_hardware/STS3215ServoControlDriver</plugin>
                <param name="port_left">/dev/ttyAMA3</param>
                <param name="port_right">/dev/ttyAMA5</param>
                <param name="baud_rate">1000000</param>
            </xacro:unless> -->
        </hardware>
        <joint name="wheel_front_right_joint">
            <command_interface name="velocity">
                <param name="min">-9</param>
                <param name="max">9</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="wheel_front_left_joint">
            <command_interface name="velocity">
                <param name="min">-9</param>
                <param name="max">9</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="wheel_rear_right_joint">
            <command_interface name="velocity">
                <param name="min">-9</param>
                <param name="max">9</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
        <joint name="wheel_rear_left_joint">
            <command_interface name="velocity">
                <param name="min">-9</param>
                <param name="max">9</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>
</robot>